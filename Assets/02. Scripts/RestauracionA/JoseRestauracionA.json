{"inkVersion":21,"root":[[{"->":"Jose01"},["done",{"#f":5,"#n":"g-0"}],null],"done",{"Jose01":["^Lo lograste Metztli.","\n","^Todo este camino te preparó para este momento.","\n","^Los códices confían en ti.","\n",{"->":"Metztli01"},{"#f":1}],"Metztli01":["^Lo sé, José…","\n","^Cada símbolo, cada trazo…","\n","^Es como si pudiera escuchar su voz, pareciera que tu amuleto me permite conectarme con los códices.","\n",{"->":"Jose02"},{"#f":1}],"Jose02":["^Escucha, entonces.","\n","^No solo restauras “papel”…","\n","^Devuelves memoria, devuelves vida.","\n",{"->":"Metztli02"},{"#f":1}],"Metztli02":["^Prometo hacerlo con respeto.","\n","^Estas memorias no deben desaparecer.","\n","end",{"#f":1}],"#f":1}],"listDefs":{}}